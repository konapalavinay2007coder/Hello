# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/hello_db?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Bhashini API Credentials
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

# Open Government Data (data.gov.in) API Key for Agmarknet
AGMARKNET_API_KEY=your_datagov_api_key
